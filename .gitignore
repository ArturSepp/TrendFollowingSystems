# Paper workspace policy: preserve existing public tf_systems files only.
/papers/*
!/papers/__init__.py
!/papers/AGENTS.md
!/papers/README.md
!/papers/tf_systems/
/papers/**/drafts/
/papers/**/private/
/papers/**/agents/
/papers/**/paper/**
/papers/**/presentations/**
/papers/**/replication/data/**
/papers/**/replication/data/local/
/papers/**/replication/results/
/papers/**/replication/outputs/
# Legacy local caches are retained on disk; new runs belong outside the checkout.
/resources/papers/

# Local Claude settings and worktrees are machine-specific.
/.claude/
